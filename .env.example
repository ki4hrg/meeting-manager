# Local development. Copy to .env.local.
DATABASE_URL=postgres://mm:mm@localhost:54329/mm
# At least 32 characters: `openssl rand -base64 48`
SESSION_SECRET=
# The external origin in production; defaults to http://localhost:3000 in development.
PUBLIC_BASE_URL=
# Google OAuth for calendar integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encryption key for stored credentials (falls back to SESSION_SECRET if unset)
CONNECT_KEY=
# Extraction after a meeting. Without a key, processing keeps only the D:/Q:/A:/T: lines.
ANTHROPIC_API_KEY=
# The model that reads the notes; defaults to claude-fable-5-1.
EXTRACTION_MODEL=
# Granola is connected on Settings with an API key, and registers its own webhook.
# Set this only for a webhook endpoint made by hand in Granola: its signing secret (whsec_…).
GRANOLA_WEBHOOK_SECRET=
# For scripts/granola-probe.ts only; the app does not read it.
GRANOLA_API_KEY=
