# Local development. Copy to .env.local.
DATABASE_URL=postgres://mm:mm@localhost:54329/mm
# At least 32 characters: `openssl rand -base64 48`
SESSION_SECRET=
# The external origin in production; defaults to http://localhost:3000 in development.
PUBLIC_BASE_URL=
# Google OAuth for calendar integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encryption key for stored credentials (falls back to SESSION_SECRET if unset)
CONNECT_KEY=
# Extraction after a meeting. Without a key, processing keeps only the D:/Q:/A:/T: lines.
ANTHROPIC_API_KEY=
# The model that reads the notes; defaults to claude-fable-5-1.
EXTRACTION_MODEL=
# Granola is connected on Settings with an API key, and registers its own webhook.
# Set this only for a webhook endpoint made by hand in Granola: its signing secret (whsec_…).
GRANOLA_WEBHOOK_SECRET=
# For scripts/granola-probe.ts only; the app does not read it.
GRANOLA_API_KEY=
# Single sign-on (OpenID Connect, e.g. Pocket ID). Off unless all three are set; two of
# three fails the boot. Register <PUBLIC_BASE_URL>/api/auth/oidc/callback with the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The button reads "Sign in with <this>"; defaults to Pocket ID.
OIDC_DISPLAY_NAME=
# true hides and refuses password sign-in while the provider is reachable.
OIDC_ONLY=
# true links the account by email even when the provider has not verified the address.
OIDC_TRUST_EMAIL=
# Todoist, through an app registered at https://developer.todoist.com/appconsole.html: OAuth
# redirect <PUBLIC_BASE_URL>/api/connect/todoist/callback, webhook <PUBLIC_BASE_URL>/api/webhooks/todoist
# with the item:* events. Both or neither; one alone fails the boot.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
