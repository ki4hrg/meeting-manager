# Local development. Copy to .env.local.
DATABASE_URL=postgres://mm:mm@localhost:54329/mm
# At least 32 characters: `openssl rand -base64 48`
SESSION_SECRET=
# The external origin in production; defaults to http://localhost:3000 in development.
PUBLIC_BASE_URL=
# Google OAuth for calendar integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encryption key for stored credentials (falls back to SESSION_SECRET if unset)
CONNECT_KEY=
